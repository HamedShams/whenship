{
  "name": "whenship",
  "version": "1.3.1",
  "description": "When will it ship, honestly? A tiny planner for small teams: live what-if Gantt, deadline risk and realistic dates. Works in the browser, offline, and inside Claude as an MCP App.",
  "license": "MIT",
  "author": "Hamed Shams (https://github.com/HamedShams)",
  "homepage": "https://github.com/HamedShams/whenship#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamedShams/whenship.git"
  },
  "bugs": {
    "url": "https://github.com/HamedShams/whenship/issues"
  },
  "keywords": [
    "gantt",
    "planning",
    "capacity-planning",
    "deadlines",
    "forecast",
    "mcp",
    "mcp-app",
    "claude",
    "project-management",
    "what-if"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "whenship": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.LEGAL.txt",
    "dist/app.html",
    "dist/whenship.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build && node scripts/inline.mjs",
    "build:node": "node scripts/build-node.mjs",
    "docs:svg": "esbuild scripts/example-svg.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module",
    "build": "npm run build:ui && npm run build:node",
    "start": "node dist/cli.js --host 0.0.0.0 --no-open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "TZ=America/Los_Angeles vitest run test/engine && TZ=Asia/Tehran vitest run test/engine && TZ=Pacific/Kiritimati vitest run test/engine",
    "check": "npm run typecheck && npm run test && npm run test:tz",
    "prepublishOnly": "npm run build && npm run check",
    "test:e2e": "npm run build && vitest run test/mcp",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "lz-string": "1.5",
    "preact": "^11.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
